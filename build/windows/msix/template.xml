<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="miku_chrono.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Miku\Miku Chrono">
    </Installer>
    <PackageInformation
        PackageName="Miku Chrono"
        PackageDisplayName="Miku Chrono"
        PublisherName="CN=Miku"
        PublisherDisplayName="Miku"
        Version="0.1.0.0"
        PackageDescription="Multi-activity check-in timer">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.miku.chrono"
                Description="Multi-activity check-in timer"
                DisplayName="Miku Chrono"
                ExecutableName="miku_chrono.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Miku Chrono</DisplayName>
            <PublisherDisplayName>Miku</PublisherDisplayName>
            <Description>Multi-activity check-in timer</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="miku_chrono.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
